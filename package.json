{
  "name": "pokemon-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pokemon-simulator/web",
    "build": "npm run build -w @pokemon-simulator/web",
    "lint": "eslint .",
    "preview": "npm run preview -w @pokemon-simulator/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run deploy -w @pokemon-simulator/web",
    "preview:worker": "npm run preview:worker -w @pokemon-simulator/web",
    "coach": "node scripts/coach-server.ts",
    "coach:remote": "COACH_HOST=0.0.0.0 node scripts/coach-server.ts",
    "dev:remote": "npm run dev:remote -w @pokemon-simulator/web",
    "update-cards": "node scripts/fetch-cards.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.81.1"
  }
}